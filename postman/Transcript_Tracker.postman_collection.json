{
  "info": {
    "name": "SWE2106 E-tivity 5 \u2014 Transcript Tracker",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Start the server and seed fictional accounts. Run requests in order. Login requests save session tokens and submission saves a reference automatically."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:3002"
    },
    {
      "key": "demoPassword",
      "value": "TranscriptDemo!26"
    },
    {
      "key": "studentToken",
      "value": ""
    },
    {
      "key": "otherToken",
      "value": ""
    },
    {
      "key": "staffToken",
      "value": ""
    },
    {
      "key": "requestId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 Database health",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/health",
        "header": []
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"SQLite responds\", () => pm.expect(pm.response.json().database).to.eql(\"connected\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Unauthenticated request is denied",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/requests",
        "header": []
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 401\", () => pm.response.to.have.status(401));"
            ]
          }
        }
      ]
    },
    {
      "name": "03 Wrong password is rejected",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/auth/login",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"student@example.test\",\n  \"password\": \"incorrect\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 401\", () => pm.response.to.have.status(401));"
            ]
          }
        }
      ]
    },
    {
      "name": "04 Sign in as student",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/auth/login",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"student@example.test\",\n  \"password\": \"{{demoPassword}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) pm.collectionVariables.set(\"studentToken\", pm.response.json().token);"
            ]
          }
        }
      ]
    },
    {
      "name": "05 Reject short purpose",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/requests",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{studentToken}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"purpose\": \"Hi\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 400\", () => pm.response.to.have.status(400));"
            ]
          }
        }
      ]
    },
    {
      "name": "06 Submit transcript request",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/requests",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{studentToken}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"purpose\": \"Graduate programme application\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "if (pm.response.code === 201) pm.collectionVariables.set(\"requestId\", pm.response.json().request.id);",
              "pm.test(\"Initial status is submitted\", () => pm.expect(pm.response.json().request.status).to.eql(\"submitted\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "07 Student cannot change status",
      "request": {
        "method": "PATCH",
        "url": "{{baseUrl}}/api/requests/{{requestId}}/status",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{studentToken}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"under_review\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 403\", () => pm.response.to.have.status(403));"
            ]
          }
        }
      ]
    },
    {
      "name": "08 Sign in as another student",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/auth/login",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"student2@example.test\",\n  \"password\": \"{{demoPassword}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) pm.collectionVariables.set(\"otherToken\", pm.response.json().token);"
            ]
          }
        }
      ]
    },
    {
      "name": "09 Another student cannot see request",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/requests/{{requestId}}",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{otherToken}}"
          }
        ]
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 404\", () => pm.response.to.have.status(404));"
            ]
          }
        }
      ]
    },
    {
      "name": "10 Sign in as registrar",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/auth/login",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"registrar@example.test\",\n  \"password\": \"{{demoPassword}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) pm.collectionVariables.set(\"staffToken\", pm.response.json().token);"
            ]
          }
        }
      ]
    },
    {
      "name": "11 Registrar sees request in queue",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/requests",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{staffToken}}"
          }
        ]
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Queue includes new request\", () => pm.expect(pm.response.json().requests.map(r => r.id)).to.include(pm.collectionVariables.get(\"requestId\")));"
            ]
          }
        }
      ]
    },
    {
      "name": "12 Reject skipped status",
      "request": {
        "method": "PATCH",
        "url": "{{baseUrl}}/api/requests/{{requestId}}/status",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{staffToken}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"ready\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 409\", () => pm.response.to.have.status(409));"
            ]
          }
        }
      ]
    },
    {
      "name": "13 Move request to review",
      "request": {
        "method": "PATCH",
        "url": "{{baseUrl}}/api/requests/{{requestId}}/status",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{staffToken}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"under_review\",\n  \"note\": \"Request received for review.\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "14 Require reason for rejection",
      "request": {
        "method": "PATCH",
        "url": "{{baseUrl}}/api/requests/{{requestId}}/status",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{staffToken}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"rejected\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 400\", () => pm.response.to.have.status(400));"
            ]
          }
        }
      ]
    },
    {
      "name": "15 Mark transcript ready",
      "request": {
        "method": "PATCH",
        "url": "{{baseUrl}}/api/requests/{{requestId}}/status",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{staffToken}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"ready\",\n  \"note\": \"Ready for collection.\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "16 Student sees status history",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/requests/{{requestId}}",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{studentToken}}"
          }
        ]
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Status history is complete\", () => pm.expect(pm.response.json().history.map(h => h.status)).to.eql([\"submitted\",\"under_review\",\"ready\"]));"
            ]
          }
        }
      ]
    },
    {
      "name": "17 Sign out as student",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/auth/logout",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{studentToken}}"
          }
        ]
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 204\", () => pm.response.to.have.status(204));"
            ]
          }
        }
      ]
    },
    {
      "name": "18 Revoked session is denied",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/requests",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{studentToken}}"
          }
        ]
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 401\", () => pm.response.to.have.status(401));"
            ]
          }
        }
      ]
    }
  ]
}
